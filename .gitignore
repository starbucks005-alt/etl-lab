# Full-size sources for the country faces. Kept on disk so a face can be
# remade, never deployed: they are 44MB of 2752px images whose only use on
# the site is a 60px chip.
assets/_originals/
sherlock-android/

# Raw full-page PNG captures behind the campus hover thumbnails. Kept on disk
# so a card's screenshot can be re-cropped without re-capturing: 12MB of
# 1280x800 originals whose only live use is a 640x400 compressed WebP.
images/campus-hover/_raw/*.png

# Robot A.L.I.C.E.'s own notes about her conversations. They stay on the robot and must never be committed.
al-panel/pi/memory_*.json

# A character made for one person, kept on the robot only (al-panel/pi/al_panel_server.py)
al-panel/pi/personalities_private.json
